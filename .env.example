# Строка подключения к Postgres.
# Локальный кластер, поднимаемый через `npm run db:up`, слушает порт 5433.
DATABASE_URL=postgres://stroycontrol@localhost:5433/stroycontrol

# Секрет для подписи cookie сессии. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32

# Пароль, которым создаются учётки пилота в `npm run db:seed`.
# В проде задать свой и сменить пароли после первого входа.
SEED_PASSWORD=stroycontrol
