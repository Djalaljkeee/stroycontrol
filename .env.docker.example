# Окружение для развёртывания через docker compose: скопировать в .env рядом с
# docker-compose.yml и заполнить. Для локальной разработки без docker — .env.example.

# Пароль пользователя postgres в контейнере db. Из него же собирается
# DATABASE_URL для приложения. Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=

# Строка подключения нужна скриптам, которые запускаются разово:
#   docker compose run --rm app npm run db:migrate
# Пароль здесь обязан совпадать с POSTGRES_PASSWORD.
DATABASE_URL=postgres://stroycontrol:ПАРОЛЬ@db:5432/stroycontrol

# Секрет для подписи cookie сессии. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# Пароль, которым создаются учётки пилота в `npm run db:seed`.
# Смены пароля в интерфейсе пилота нет — задать сразу тот, что раздаётся людям.
SEED_PASSWORD=

# Внешняя docker-сеть обратного прокси. По умолчанию caddy_net.
# PROXY_NETWORK=caddy_net
